<sumi:imports>
"strings"
</sumi:imports>

<style>
.backdrop { position: fixed; }
.overlay { border: single; border-title: "Connection"; padding: 1 2; min-width: 56; background: black; }
.status-ok { bold: true; color: #50fa7b; }
.status-err { bold: true; color: #ff5555; }
.url { dim: true; }
.meta { dim: true; }
.tab-header { dim: true; border-bottom: single; padding: 1 0 0 0; }
.filter { direction: row; }
.filter-prompt { bold: true; }
.filter-text { color: #f1fa8c; }
.tab-list { overflow: auto; }
.tab { padding: 0 1; direction: row; gap: 2; }
.tab:hover { color: white; }
.tab-selected { bold: true; color: white; }
.tab-title { min-width: 24; }
.tab-url { dim: true; }
.hints { dim: true; border-top: single; padding: 1 0 0 0; direction: row; gap: 2; }
</style>

<script>
termW := sumi.Env[int]("width")
termH := sumi.Env[int]("height")
var visible *sumi.Signal[bool]
var connected *sumi.Signal[bool]
var pageTitle *sumi.Signal[string]
var pageURL *sumi.Signal[string]
var targetID *sumi.Signal[string]
var browserVersion *sumi.Signal[string]
var tabs *sumi.Signal[[]TabInfo]
var selectedIdx *sumi.Signal[int]
var filter *sumi.Signal[string]

func getFilteredTabs() []TabInfo {
	f := strings.ToLower(filter.Get())
	if f == "" {
		return tabs.Get()
	}
	filtered := []TabInfo{}
	for _, t := range tabs.Get() {
		if strings.Contains(strings.ToLower(t.Title), f) || strings.Contains(strings.ToLower(t.URL), f) {
			filtered = append(filtered, t)
		}
	}
	return filtered
}

func close() {
	visible.Set(false)
}

func noop() {
}
</script>

{if visible.Get()}
<box class="backdrop" width={termW.Get()} height={termH.Get()} onclick={close}>
    <box class="overlay" onclick={noop}>
        {if connected.Get()}
            <box class="status-ok"><text>● Connected to {pageTitle}</text></box>
            <box class="url"><text>{pageURL}</text></box>
            <box class="meta"><text>Target: {targetID}  Browser: {browserVersion}</text></box>
        {else}
            <box class="status-err"><text>● Disconnected — reconnecting every 2s</text></box>
            <box class="url"><text>Last: {pageTitle} — {pageURL}</text></box>
        {/if}
        <box class="tab-header"><text>Tabs</text></box>
        <box class="filter">
            <box class="filter-prompt"><text>❯ </text></box>
            <box class="filter-text"><text>{filter}</text></box>
        </box>
        <box class="tab-list">
            {for i, tab := range getFilteredTabs() key=tab.ID}
                {if i == selectedIdx.Get()}
                    <box class="tab tab-selected">
                        <box class="tab-title"><text>→ {tab.Title}</text></box>
                        <box class="tab-url"><text>{tab.URL}</text></box>
                    </box>
                {else}
                    <box class="tab">
                        <box class="tab-title"><text>  {tab.Title}</text></box>
                        <box class="tab-url"><text>{tab.URL}</text></box>
                    </box>
                {/if}
            {/for}
        </box>
        <box class="hints">
            <text>↑↓ Select</text>
            <text>Enter Switch</text>
            <text>f Focus</text>
            <text>n New Tab</text>
            <text>Esc Close</text>
        </box>
    </box>
</box>
{/if}
